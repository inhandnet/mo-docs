# Hardware downloads are stored with Git LFS; the website build fetches them.
hardware/products/*/files/*.pdf filter=lfs diff=lfs merge=lfs -text
hardware/products/*/files/*.zip filter=lfs diff=lfs merge=lfs -text
hardware/products/*/files/*.dxf filter=lfs diff=lfs merge=lfs -text
hardware/products/*/files/*.rar filter=lfs diff=lfs merge=lfs -text
